{
  "name": "legendary-shots",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project component",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:trace": "node scripts/test-trace.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm test:coverage && pnpm test:int && pnpm test:trace",
    "arch": "depcruise app server shared --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@sentry/nuxt": "^11.12.0",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0",
    "postgres": "^4.1.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "13.6.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.165.0"
  }
}
