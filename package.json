{
  "name": "legendary-shots",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "predev": "node scripts/preflight.mjs",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint . && prettier --check . && stylelint \"app/**/*.{css,vue}\"",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project component",
    "test:coverage": "vitest run --coverage",
    "pretest:int": "node scripts/preflight.mjs",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:trace": "node scripts/test-trace.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm test:coverage && pnpm test:trace",
    "arch": "depcruise app server shared --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "node scripts/preflight.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "predb:seed": "node scripts/preflight.mjs",
    "db:seed": "node scripts/seed.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@noble/hashes": "^2.4.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxtjs/i18n": "10.6.0",
    "@sentry/nuxt": "^11.12.0",
    "@vite-pwa/nuxt": "1.1.1",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "nuxt-security": "^2.7.0",
    "postgres": "^4.1.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/storybook": "10.0.3",
    "@playwright/test": "^1.65.1",
    "@storybook-vue/nuxt": "10.0.3",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "13.6.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.10.1",
    "storybook": "10.6.7",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.165.0"
  }
}
