#!/bin/sh
# Refuse un commit qui contient un secret (CLAUDE.md : aucun secret dans le code).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks est introuvable : installez-le (Windows : winget install Gitleaks.Gitleaks), puis rouvrez le terminal." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
