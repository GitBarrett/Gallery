# Variables de l'application (03-architecture.md § Configuration et secrets).
# Copier en .env pour le développement local ; jamais de valeur réelle ici.
# Les bindings Cloudflare (R2, IMAGES, HYPERDRIVE, Queues, RATE_LIMITER_*) se déclarent dans wrangler.toml.

# Session (≥ 32 caractères)
NUXT_SESSION_PASSWORD=

# Base Neon (local : branche dev-{prénom} ; production et previews : binding HYPERDRIVE)
DATABASE_URL=

# R2 : URL présignées (jeton S3 limité au bucket)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Purge du cache /img (permission « Cache Purge » sur la zone uniquement)
CF_API_TOKEN_PURGE=
CF_ZONE_ID=

# OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_BATTLEDOTNET_CLIENT_ID=
NUXT_OAUTH_BATTLEDOTNET_CLIENT_SECRET=

# Anti-bot
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Modération et emails
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
RESEND_API_KEY=

# Bug reports vers GitHub
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_FEEDBACK_REPO=

# HMAC des IP (rotation 30 jours) et chiffrement des secrets TOTP
IP_HASH_KEY_CURRENT=
IP_HASH_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY=

# Suivi d'erreurs, analytics, URL publique
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Fournisseurs factices : true en local et en preview uniquement, refusé en production
NUXT_FAKE_PROVIDERS=true
