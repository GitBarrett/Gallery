# Application variables (03-architecture.md § Configuration et secrets).
# Copy to .env for local development; never a real value here.
# Cloudflare bindings (R2, IMAGES, HYPERDRIVE, Queues, RATE_LIMITER_*) are declared in wrangler.toml.

# Root secret of Nuxt, seals the session cookie (≥ 32 characters, `openssl rand -base64 32`; generated by `nuxt dev` if empty)
NUXT_APP_SECRET=

# Neon database (local: dev-{firstname} branch, in .env.test for tests; production and previews: HYPERDRIVE binding)
DATABASE_URL=

# R2: presigned URLs (S3 token limited to the bucket)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# /img cache purge ("Cache Purge" permission on the zone only)
CF_API_TOKEN_PURGE=
CF_ZONE_ID=

# OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_BATTLEDOTNET_CLIENT_ID=
NUXT_OAUTH_BATTLEDOTNET_CLIENT_SECRET=

# Anti-bot
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Moderation and emails
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
RESEND_API_KEY=

# Bug reports vers GitHub
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_FEEDBACK_REPO=

# IP HMAC (30-day rotation) and TOTP secret encryption
IP_HASH_KEY_CURRENT=
IP_HASH_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY=

# Suivi d'erreurs, analytics, URL publique
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_CF_BEACON_TOKEN=
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Fake providers: true locally and on previews only, refused in production
NUXT_FAKE_PROVIDERS=true
# Consent page of the fake OAuth providers (a test route, built for previews only)
NUXT_FAKE_OAUTH_CONSENT_URL=http://localhost:3000/__test/oauth

# Local operations scripts (scripts/preview.mjs: up, down, sweep); in CI, GitHub secrets of the same name
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEON_API_KEY=
NEON_PROJECT_ID=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
